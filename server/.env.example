PORT=3001
SAVEITUP_API_KEY=replace-with-a-long-random-string
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# AI provider for summaries (optional). One of: ollama, anthropic, openai, gemini, openrouter, nvidia
# SUMMARY_PROVIDER=ollama
# AI provider for folder categorization (optional, defaults to SUMMARY_PROVIDER if unset)
# CATEGORIZE_PROVIDER=ollama
# Ollama (free, local — run `ollama serve` and `ollama pull llama3.1:8b` first)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.1:8b

# Ollama Cloud (https://ollama.com/cloud — sign in for an API key)
# OLLAMA_CLOUD_API_KEY=
# OLLAMA_CLOUD_BASE_URL=https://ollama.com/v1
# OLLAMA_CLOUD_MODEL=gpt-oss:120b-cloud

# NVIDIA NIM (https://build.nvidia.com — free API key, hosts Gemma/Mistral/Llama/Nemotron models)
# NVIDIA_API_KEY=
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=mistralai/mistral-7b-instruct-v0.3
# Used for cleanup specifically (long-text rewrite) — kept separate from NVIDIA_MODEL above
# since reasoning-tuned models can misread cleanup as a question to answer instead of editing.
# NVIDIA_CLEANUP_MODEL=meta/llama-3.3-70b-instruct

# Parallel cleanup worker pool (optional). Comma-separated list of providers to fan
# chunks of a long page out to concurrently during auto-cleanup, instead of the single
# CLEANUP_PROVIDER/SUMMARY_PROVIDER. Only providers with credentials configured above are
# actually used — list ones you want spending cloud credits on cleanup.
# Example: CLEANUP_WORKERS=ollama,ollama_cloud,gemini,nvidia
# CLEANUP_WORKERS=

# Embedding provider for semantic search + chat retrieval (optional). One of: openai, gemini, nvidia
# EMBEDDING_PROVIDER=nvidia
# NVIDIA_EMBEDDING_MODEL=baai/bge-m3

# AI provider for the chat feature (optional, defaults to SUMMARY_PROVIDER if unset)
# CHAT_PROVIDER=nvidia
