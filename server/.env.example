PORT=3001
SAVEITUP_API_KEY=replace-with-a-long-random-string
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Only needed to run `npm run check:rls` (server/scripts/check-rls.ts), which acts as a
# real signed-in anon-key client to verify cross-account access is denied. The server
# itself never uses the anon key — it always connects with the service-role key above.
# SUPABASE_ANON_KEY=

# Identity used for requests authenticated via the static SAVEITUP_API_KEY (mcp-server,
# or any other caller that isn't a real signed-in Supabase Auth user). Defaults to a
# fixed placeholder uuid if unset.
# DEV_FAKE_USER_ID=

# Comma-separated list of allowed browser Origin headers for CORS (e.g. a web dashboard).
# Extension pages bypass CORS via host_permissions, so they don't need to be listed here.
# Leave unset to allow all origins (fine for local dev, not recommended in production).
# ALLOWED_ORIGINS=

# AI provider for summaries (optional). One of: ollama, anthropic, openai, gemini, openrouter, nvidia
# SUMMARY_PROVIDER=ollama
# AI provider for folder categorization (optional, defaults to SUMMARY_PROVIDER if unset)
# CATEGORIZE_PROVIDER=ollama
# AI provider for cleanup (optional, defaults to SUMMARY_PROVIDER if unset)
# CLEANUP_PROVIDER=ollama
# Max characters per chunk when splitting a long page for cleanup (optional)
# CLEANUP_CHUNK_CHARS=20000

# Ollama (free, local — run `ollama serve` and `ollama pull llama3.1:8b` first)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.1:8b

# Ollama Cloud (https://ollama.com/cloud — sign in for an API key)
# OLLAMA_CLOUD_API_KEY=
# OLLAMA_CLOUD_BASE_URL=https://ollama.com/v1
# OLLAMA_CLOUD_MODEL=gpt-oss:120b-cloud

# Anthropic (https://console.anthropic.com)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# OpenAI (https://platform.openai.com)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Gemini (https://aistudio.google.com/apikey)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_EMBEDDING_MODEL=text-embedding-004

# OpenRouter (https://openrouter.ai/keys — hosts many models, including free-tier ones)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# OpenRouter's embeddings endpoint (https://openrouter.ai/api/v1/embeddings) is fixed —
# it isn't configurable via a base-url override the way the chat-completions one is.
# OPENROUTER_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free

# NVIDIA NIM (https://build.nvidia.com — free API key, hosts Gemma/Mistral/Llama/Nemotron models)
# NVIDIA_API_KEY=
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=mistralai/mistral-7b-instruct-v0.3
# Used for cleanup specifically (long-text rewrite) — kept separate from NVIDIA_MODEL above
# since reasoning-tuned models can misread cleanup as a question to answer instead of editing.
# NVIDIA_CLEANUP_MODEL=meta/llama-3.3-70b-instruct
# NVIDIA_EMBEDDING_MODEL=baai/bge-m3

# Parallel cleanup worker pool (optional). Comma-separated list of providers to fan
# chunks of a long page out to concurrently during auto-cleanup, instead of the single
# CLEANUP_PROVIDER/SUMMARY_PROVIDER. Only providers with credentials configured above are
# actually used — list ones you want spending cloud credits on cleanup.
# Example: CLEANUP_WORKERS=ollama,ollama_cloud,gemini,nvidia
# CLEANUP_WORKERS=

# Embedding provider for semantic search + chat retrieval (optional). One of: openai, gemini, nvidia, openrouter
# EMBEDDING_PROVIDER=nvidia

# AI provider for the chat feature (optional, defaults to SUMMARY_PROVIDER if unset)
# CHAT_PROVIDER=nvidia
