# Default backend URL baked into a production build. Leave unset for local dev
# (falls back to http://localhost:3001); set this before shipping a real build.
SAVEITUP_DEFAULT_API_BASE=

# Supabase project (public anon key, safe to bundle — RLS is the real gate).
# Used for both auth (email/password sign-in) and direct CRUD calls
# (pages/folders) so those don't need to round-trip through the Express
# server. Get these from the Supabase project settings.
SUPABASE_URL=
SUPABASE_ANON_KEY=
